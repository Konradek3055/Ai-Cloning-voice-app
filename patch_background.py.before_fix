# =================== 4. XttsSynthesizer: wątki ustawiane w locie ===================
s = T['syn']
s = rep(s, '    private val numThreads: Int = 2,\n', '    numThreads: Int = 4,\n')
s = rep(s, '    private val cancelled = AtomicBoolean(false)\n',
           '    private val cancelled = AtomicBoolean(false)\n    @Volatile private var threads: Int = numThreads.coerceIn(1, 8)\n')
s = rep(s, 'XtTsOnnxRuntime.openSessions(modelDir, numThreads, useNnapi', 'XtTsOnnxRuntime.openSessions(modelDir, threads, useNnapi', count=4)
s = rep(s, '    /** Changes the XTTS provider while idle; releases old sessions before reopening. */\n',
'''    /** Zmienia liczbę wątków CPU (1-8); modele załadują się ponownie przy następnej syntezie. */
    fun setThreads(count: Int) {
        val target = count.coerceIn(1, 8)
        if (threads == target) return
        cancelled.set(true)
        exclusive {
            check(!closed) { "Silnik XTTS został zamknięty." }
            if (threads == target) return
            unloadLocked()
            threads = target
            executionProviderStatus =
                if (requestedExecutionProvider == "nnapi") "NNAPI — oczekuje na załadowanie modelu" else "CPU — gotowy"
        }
    }

    /** Changes the XTTS provider while idle; releases old sessions before reopening. */
''')
