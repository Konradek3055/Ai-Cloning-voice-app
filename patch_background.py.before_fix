m = rep(m, '} finally { xttsSynthesizing = false; busy = false }',
           '} finally { xttsSynthesizing = false; busy = false; KeepAlive.end(context) }')

# pobieranie Supertonic
m = rx(m, r'scope\.launch \{(\s*busy = true\s*progress = 0f\s*progressEta = "Szacowanie czasu…"\s*status = "Pobieram i weryfikuję Supertonic 3…")',
          r'KeepAlive.appScope.launch {\1\n                                            KeepAlive.begin(context, "Pobieram model Supertonic…")')
m = rx(m, r'(status = "Błąd pobierania: \$\{e\.message \?: e::class\.java\.simpleName\}"\s*\} finally \{\s*busy = false)(\s*\})',
          r'\1\n                                                KeepAlive.end(context)\2')
# pobieranie XTTS
m = rx(m, r'(val tokenForDownload = hfToken\.trim\(\)\s*)scope\.launch \{(\s*busy = true)',
          r'\1KeepAlive.appScope.launch {\2\n                                            KeepAlive.begin(context, "Pobieram model XTTS…")')
m = rx(m, r'(\(e\.message \?: e::class\.java\.simpleName\)\s*\} finally \{\s*busy = false)(\s*\})',
          r'\1\n                                                KeepAlive.end(context)\2')
# zamknięcie silnika dopiero gdy nic nie pracuje w tle
m = rep(m, 'supertonic.close()\n            xttsRuntime.close()',
