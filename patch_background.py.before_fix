m = rep(m, 'status = "XTTS wygenerował WAV: ${wav.name}"',
'''val audioSeconds = ((wav.length() - 44L).coerceAtLeast(0L)) / 2.0 / 24000.0
                                                    val elapsedSeconds = (System.nanoTime() - synthStartedAt) / 1e9
