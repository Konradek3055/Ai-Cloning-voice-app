# =================== 6. XTTS: token tylko do huggingface.co, ręczne przekierowania ===================
x = T['xmm']
start = x.index('    private fun openConnection(')
end = x.index('    companion object {')
if 'Authorization' not in x[start:end] or end < start:
    fail('nie rozpoznaję funkcji openConnection w XttsModelManager.kt')
NEW_OPEN = r'''    private fun openConnection(
        address: String,
        token: String
    ): HttpURLConnection {
        var current = address
        var redirects = 0
        while (true) {
            val url = URL(current)
            require(url.protocol == "https") { "Odrzucono połączenie bez HTTPS: $current" }
            val host = url.host.lowercase()
            // Token Hugging Face wysyłamy tylko do huggingface.co, nigdy do hostów CDN z przekierowań.
            val trusted = host == "huggingface.co" || host.endsWith(".huggingface.co")
            val connection = (url.openConnection() as HttpURLConnection).apply {
                connectTimeout = 30_000
                readTimeout = 180_000
                instanceFollowRedirects = false
                requestMethod = "GET"
                if (trusted) setRequestProperty("Authorization", "Bearer $token")
                setRequestProperty("User-Agent", "KinoTTS-Studio-Android")
                setRequestProperty("Cache-Control", "no-cache")
            }
            val code = connection.responseCode
            if (code in 300..399 && code != 304) {
                val location = connection.getHeaderField("Location")
                connection.disconnect()
                require(location != null && redirects < 6) { "Zbyt wiele przekierowań albo brak adresu docelowego." }
                current = URL(url, location).toString()
                redirects++
                continue
            }
            return connection
        }
    }

'''
x = x[:start] + NEW_OPEN + x[end:]
T['xmm'] = x

# =================== zapis ===================
backup = P('.kinotts_patch_backup/background_' + time.strftime('%Y%m%d_%H%M%S'))
os.makedirs(backup, exist_ok=True)
for key, rel in FILES.items():
    shutil.copy2(P(rel), os.path.join(backup, os.path.basename(rel)))
for key, rel in FILES.items():
    with open(P(rel), 'w', encoding='utf-8', newline='\n') as f: f.write(T[key])
os.makedirs(P(NEW_DIR), exist_ok=True)
with open(P(NEW_DIR + 'KeepAlive.kt'), 'w', encoding='utf-8', newline='\n') as f: f.write(KEEPALIVE)

print('OK. Kopie zapasowe: %s' % backup)
print(' 1. Synteza i pobieranie modeli działają dalej po wyjściu z aplikacji (usługa z powiadomieniem)')
print(' 2. Supertonic: weryfikacja SHA-256 pobranego archiwum')
print(' 3. XTTS: token HF tylko do huggingface.co (ręczne, bezpieczne przekierowania)')
print(' 4. XTTS: suwak wątków CPU (1-8, domyślnie 4; było na sztywno 2) + czas generowania w statusie')
